# Application Environment Variables Template

NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Database configuration
DATABASE_URL=postgresql://cloudops:cloudops_dev_password@localhost:5432/cloudops

# Authentication secrets (Generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_long_random_development_secret_min32chars
AUTH_TOKEN_TTL=15m

# CloudOps Provider: 'demo' (deterministic fixtures) or 'aws' (live AWS SDK v3)
CLOUD_PROVIDER=demo

# AWS Configuration (read-only least privilege when CLOUD_PROVIDER=aws)
AWS_REGION=ap-south-1
AWS_LOG_GROUPS=/aws/ec2/prod-api-gateway,/aws/ec2/prod-worker-batch

# Polling Interval
DASHBOARD_REFRESH_SECONDS=60
